# --- Olian ---------------------------------------------------------------
OLIAN_API_KEY=change-me-long-random          # admin API key (admin API is disabled without it)
OLIAN_WEBHOOK_SECRET=change-me-too           # HMAC secret for /webhooks/{project}/{source}
OLIAN_DATA_DIR=./data
OLIAN_PORT_BASE=8700                         # first per-project Hermes API port
# Model for every new project's Hermes (project config can override). Provider keys go in project config "env".
OLIAN_DEFAULT_PROVIDER=
OLIAN_DEFAULT_MODEL=
# Where a project's Hermes (maybe inside a docker sandbox) reaches Olian's MCP facade:
# OLIAN_AGENT_API_URL=http://host.docker.internal:8600

# --- Notifications / channels -------------------------------------------
OLIAN_NOTIFY_TELEGRAM_TOKEN=                 # fallback bot for notifications when a project has no bot of its own
WHATSAPP_CLOUD_TOKEN=                        # Meta WhatsApp Business Cloud API (official; required for outreach)
WHATSAPP_VERIFY_TOKEN=                       # you choose it; paste into Meta's webhook setup
WHATSAPP_APP_SECRET=                         # Meta app secret: inbound webhooks are rejected without it
